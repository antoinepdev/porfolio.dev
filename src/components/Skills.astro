---
import skills from "@/data/skills.json"
---

<div class="flex flex-col gap-10 mt-10">
  {
    skills.map((group) => (
      <div>
        <h3 class="mb-4 text-sm font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400">
          {group.category}
        </h3>
        <ul class="flex flex-wrap gap-2.5">
          {group.skills.map((skill) => (
            <li
              class="rounded-full border border-yellow-500/25 bg-yellow-400/10 px-4 py-1.5 text-sm font-medium text-gray-700 dark:text-gray-200"
            >
              {skill}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>