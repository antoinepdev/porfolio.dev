---
import Layout from "@/layouts/Layout.astro"

import AboutMe from "@/components/AboutMe.astro"
import Code from "@/components/icons/Code.astro"
import CodeDots from "@/components/icons/CodeDots.astro"
import Hero from "@/components/Hero.astro"
import Projects from "@/components/Projects.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import Skills from "@/components/Skills.astro"
import TitleSection from "@/components/TitleSection.astro"
import UserHeart from "@/components/icons/UserHeart.astro"
---

<Layout
  title="Antoine Peña Amores - Desarrollador Fullstack especializado en Backend"
  description="Portfolio de Antoine Peña Amores. Desarrollador Fullstack de Cuba especializado en backend. Creador del ecosistema Cinerat, un canal de Telegram con más de 17.7k suscriptores."
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero>
    </Hero>
    </SectionContainer>
    <div class="space-y-24">
    <SectionContainer id="tecnologias">
      <TitleSection>
        <Code class="size-7" />
        Tecnologías
      </TitleSection>
      <Skills />
    </SectionContainer>

    <SectionContainer id="proyectos">
      <TitleSection>
        <CodeDots class="size-7" />
        Proyectos
      </TitleSection>
      <Projects />
    </SectionContainer>

    <SectionContainer id="sobre-mi">
      <TitleSection>
        <UserHeart class="size-8" />
        Sobre mí
      </TitleSection>
      <AboutMe />
    </SectionContainer>
  </div>
  </main>
</Layout>